generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          Role      @default(CLIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  therapistClients ClientTherapist[] @relation("Therapist")
  clientTherapists ClientTherapist[] @relation("Client")
  workoutsAsTherapist Workout[] @relation("WorkoutTherapist")
  workoutsAsClient    Workout[] @relation("WorkoutClient")
  sentMessages      Message[] @relation("SentMessages")
  receivedMessages  Message[] @relation("ReceivedMessages")
}

enum Role {
  THERAPIST
  CLIENT
}

model ClientTherapist {
  id          String   @id @default(cuid())
  therapistId String
  clientId    String
  createdAt   DateTime @default(now())

  therapist   User @relation("Therapist", fields: [therapistId], references: [id])
  client      User @relation("Client", fields: [clientId], references: [id])

  @@unique([therapistId, clientId])
}

model Workout {
  id          String   @id @default(cuid())
  title       String
  therapistId String
  clientId    String
  scheduledFor DateTime
  status      WorkoutStatus @default(UPCOMING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  therapist   User @relation("WorkoutTherapist", fields: [therapistId], references: [id])
  client      User @relation("WorkoutClient", fields: [clientId], references: [id])
  exercises   Exercise[]
}

enum WorkoutStatus {
  UPCOMING
  COMPLETED
}

model Exercise {
  id           String   @id @default(cuid())
  workoutId    String
  name         String
  instructions String
  youtubeUrl   String?
  status       ExerciseStatus @default(PENDING)

  workout      Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  result       ExerciseResult?
}

enum ExerciseStatus {
  PENDING
  COMPLETED
}

model ExerciseResult {
  id         String   @id @default(cuid())
  exerciseId String   @unique
  feedback   String?  // Client text
  mediaUrl   String?  // Cloudinary URL
  createdAt  DateTime @default(now())

  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  aiInsight  String?  // Generated by NVIDIA API based on feedback
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime @default(now())

  sender     User @relation("SentMessages", fields: [senderId], references: [id])
  receiver   User @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

model InviteToken {
  id          String   @id @default(cuid())
  token       String   @unique
  therapistId String
  email       String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}
